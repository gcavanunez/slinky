{
  "name": "@gcavanunez/slinky",
  "version": "0.1.0",
  "description": "Standalone CLI and TUI for managing a separate agent skills repository.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcavanunez/slinky.git"
  },
  "bugs": {
    "url": "https://github.com/gcavanunez/slinky/issues"
  },
  "homepage": "https://github.com/gcavanunez/slinky#readme",
  "bin": {
    "slinky": "bin/slinky.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "cli": "bun src/standalone.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --tsconfig tsconfig.json src/ scripts/ bin/",
    "format": "oxfmt src/ scripts/ bin/",
    "format:check": "oxfmt --check src/ scripts/ bin/",
    "build:bin": "bun build --compile --bytecode --format=esm ./src/standalone.ts --outfile dist/slinky",
    "build:standalone": "bun run scripts/build-standalone.ts",
    "build:npm-packages": "bun run scripts/build-npm-packages.ts",
    "package:smoke": "bun run scripts/package-smoke.ts",
    "changeset": "npm exec --package @changesets/cli@2.31.0 -- changeset",
    "changeset:status": "npm exec --package @changesets/cli@2.31.0 -- changeset status",
    "changeset:version": "npm exec --package @changesets/cli@2.31.0 -- changeset version",
    "prepublishOnly": "printf '%s\n' 'Publish dist/npm/main, not the source checkout.' && exit 1"
  },
  "dependencies": {
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "effect": "4.0.0-beta.102",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-plugin-react-doctor": "^0.9.2",
    "typescript": "7.0.2"
  }
}
